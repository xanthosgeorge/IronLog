{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "IronLog - Azure",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "IronLog - Local iOS",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define=API_BASE_URL=http://localhost:5090"]
    },
    {
      "name": "IronLog - Local Android",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define=API_BASE_URL=http://10.0.2.2:5090"]
    }
  ]
}
